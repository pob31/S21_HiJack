/target
Builds
/.claude
.vs/
.DS_Store
**/.DS_Store

# Operator-saved show files — don't commit personal show data.
# Canonical extension is `.s21show`; legacy `.json` shows and the
# pre-extension bare-name files some test sessions left behind are
# also covered.
*.s21show
S21_test_*
test_s21

# The CJK subset source (NotoSansCJKsc-Regular.otf) IS committed so the subset
# can be regenerated on any machine. These two SC variants are git-ignored —
# they lack Korean hangul, so they can't produce the zh/ja/ko subset (kept
# locally only, if at all).
/assets/fonts/NotoSansSC-Regular.ttf
/assets/fonts/NotoSansSC-VariableFont_wght.ttf

# Desktop release artifacts — every packaging script stages here:
#   scripts/build-linux-release.sh  -> .tar.gz + .sha256
#   scripts/build-macos-release.sh  -> S21 HiJack.app, .dmg + .sha256
/dist

# OS packaging byproducts that can land outside /dist
*.dmg                 # macOS disk images, wherever built
*.app/                # macOS app bundles, wherever built
*.iconset/            # transient iconset staged for iconutil
/Output               # Windows Inno Setup compiler output (assets/*.iss)
*.AppImage            # Linux AppImage, if produced ad hoc
