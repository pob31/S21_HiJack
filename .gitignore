# Operator-saved show files — don't commit personal show data.
# Canonical extension is `.s21show`; legacy `.json` shows and the
# pre-extension bare-name files some test sessions left behind are
# also covered.
*.s21show
S21_test_*
test_s21

# The CJK subset source (NotoSansCJKsc-Regular.otf) IS committed so the subset
# can be regenerated on any machine. These two SC variants are git-ignored —
# they lack Korean hangul, so they can't produce the zh/ja/ko subset (kept
# locally only, if at all).
/assets/fonts/NotoSansSC-Regular.ttf
/assets/fonts/NotoSansSC-VariableFont_wght.ttf
