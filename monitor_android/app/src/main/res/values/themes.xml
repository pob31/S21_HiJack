<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pure-Compose app: this base theme only removes the action bar and sets
         a dark window/system-bar background. All real theming is in
         ui/theme/Theme.kt via MaterialTheme. -->
    <style name="Theme.S21Monitor" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
