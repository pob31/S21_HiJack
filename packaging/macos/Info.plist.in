<?xml version="1.0" encoding="UTF-8"?>
<!--
  Info.plist template for the S21 HiJack macOS app bundle.

  `@VERSION@` is substituted from Cargo.toml by scripts/build-macos-release.sh.
  Keep CFBundleExecutable / CFBundleIconFile in sync with what that script
  stages into Contents/MacOS and Contents/Resources.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>S21 HiJack</string>
    <key>CFBundleDisplayName</key>
    <string>S21 HiJack</string>
    <key>CFBundleIdentifier</key>
    <string>com.pob31.s21hijack</string>
    <key>CFBundleExecutable</key>
    <string>s21_hijack</string>
    <key>CFBundleIconFile</key>
    <string>s21_hijack</string>
    <key>CFBundleVersion</key>
    <string>@VERSION@</string>
    <key>CFBundleShortVersionString</key>
    <string>@VERSION@</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © Pierre-Olivier Boulant. Licensed under MIT OR Apache-2.0.</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.music</string>

    <!-- .s21show document association (mirrors the Linux MIME / Windows reg assets). -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>S21 HiJack Show</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.pob31.s21hijack.s21show</string>
            </array>
        </dict>
    </array>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.pob31.s21hijack.s21show</string>
            <key>UTTypeDescription</key>
            <string>S21 HiJack Show</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>s21show</string>
                </array>
                <key>public.mime-type</key>
                <array>
                    <string>application/x-s21show</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
